{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lartycc.dev/schemas/realtime-qualification-v1.schema.json",
  "title": "LarTycc realtime qualification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "device_id", "device_name", "sample_rate",
    "period_frames", "nominal_period_ms", "duration_seconds",
    "expected_callbacks", "callback_count", "deadline_misses",
    "max_callback_gap_ms", "max_process_time_ms", "pass"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": { "type": "string" },
    "device_name": { "type": "string", "minLength": 1 },
    "sample_rate": { "type": "integer", "minimum": 8000, "maximum": 384000 },
    "period_frames": { "type": "integer", "minimum": 16, "maximum": 8192 },
    "nominal_period_ms": { "type": "number", "exclusiveMinimum": 0 },
    "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
    "expected_callbacks": { "type": "integer", "minimum": 1 },
    "callback_count": { "type": "integer", "minimum": 0 },
    "deadline_misses": { "type": "integer", "minimum": 0 },
    "max_callback_gap_ms": { "type": "number", "minimum": 0 },
    "max_process_time_ms": { "type": "number", "minimum": 0 },
    "pass": { "type": "boolean" }
  }
}
